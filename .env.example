# Generate ADMIN_API_TOKEN locally; minimum 32 characters. Never commit its value.
ADMIN_API_TOKEN=
DATABASE_URL=sqlite:///./arogya.db
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
TRUSTED_ORIGINS=[]
# Phase 2: exact browser origin used by your Mac/mobile; no wildcards.
# TRUSTED_ORIGINS=["https://192.168.1.20:5173"]
VOICE_COOKIE_SECURE=true
WHISPER_MODEL_PATH=.models/faster-whisper-tiny.en

# Explicit defaults; no model is downloaded or changed during a call.
AI_PROFILE=auto
TTS_ENGINE=auto
# macOS optional installed system voice:
# TTS_VOICE=Samantha
PIPER_MODEL_PATH=.models/piper/en_US-lessac-low.onnx
# PIPER_CONFIG_PATH defaults to PIPER_MODEL_PATH + .json
